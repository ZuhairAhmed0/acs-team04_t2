# ==============================================================================
# Fuel Management System Backend Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=8080
APP_ENV=production

# Security & Authentication (Generate a secure random string for JWT_SECRET_KEY)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Database Configuration (PostgreSQL)
# Option 1: Full connection string (Recommended for Render, Supabase, Neon)
DATABASE_URL=postgres://username:password@hostname:5432/dbname?sslmode=require

# Option 2: Individual variables (used if DATABASE_URL is not provided)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=fuel_db
POSTGRES_TIMEZONE=Africa/Khartoum
POSTGRES_SSLMODE=disable

# Logging Configuration
LOG_PATH=logs

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# CORS Configuration (comma-separated origins or *; set to your frontend domain in production)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,http://localhost:5173
